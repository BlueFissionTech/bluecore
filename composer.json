{
    "name": "bluefission/bluecore",
    "description": "Modular, event-driven application framework built on DevElation",
    "homepage": "https://github.com/BlueFissionTech/bluecore",
    "license": "MIT",
    "type": "composer-plugin",
    "keywords": [
        "bluecore",
        "bluefission",
        "materia",
        "php",
        "framework",
        "event-driven",
        "plugins",
        "code-generation"
    ],
    "authors": [
        {
            "name": "Devon Scott",
            "email": "dscott@bluefission.com",
            "homepage": "https://bluefission.com",
            "role": "Developer"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "bluefission/develation": "^1.3.41",
        "composer/installers": "^1.11",
        "composer-plugin-api": "^2.0",
        "vlucas/phpdotenv": "^5.5",
        "phpoption/phpoption": "^1.9",
        "phpoffice/phpspreadsheet": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.1@dev"
    },
    "suggest": {
        "bluefission/presence": "Enables the optional authenticated host bridge for Presence identity, session, policy, and audit contracts."
    },
    "scripts": {
        "lint": "@php scripts/lint.php",
        "test": "phpunit --do-not-cache-result tests",
        "test:installer": "@php tests/Integration/project-installer-parity.php",
        "ci": [
            "Composer\\Config::disableProcessTimeout",
            "composer validate --no-check-publish --strict",
            "@lint",
            "@test"
        ]
    },
    "autoload": {
        "psr-4": {
            "BlueFission\\": "src/"
        },
        "classmap": [
           "src/"
        ],
        "files": [
            "src/Helpers/global.php",
            "src/Helpers/response.php",
            "src/Helpers/errors.php"
        ]
    },
    "autoload-dev": {
        "psr-4": { 
            "BlueFission\\Tests\\": "tests/" 
        }
    },
    "extra": {
        "class": "BlueFission\\BlueCore\\Installers\\PluginInstaller",
        "plugin-modifies-install-path": true
    },
    "config": {
        "platform-check": true,
        "allow-plugins": {
            "composer/installers": true,
            "php-http/discovery": true
        },
        "audit": {
            "abandoned": "report"
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/.codex",
            "/.github",
            "/.phpunit.cache",
            "/.phpunit.result.cache",
            "/AGENTS.behavior.md",
            "/AGENTS.md",
            "/AGENTS.standards.md",
            "/SPEC.md",
            "/artifacts",
            "/composer.lock",
            "/docs",
            "/examples",
            "/harness.json",
            "/phpunit.xml",
            "/phpunit.xml.dist",
            "/scripts",
            "/tests",
            "/tests.md",
            "/vendor"
        ]
    },
    "support": {
        "issues": "https://github.com/BlueFissionTech/bluecore/issues",
        "source": "https://github.com/BlueFissionTech/bluecore"
    }
}
